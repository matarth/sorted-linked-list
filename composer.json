{
    "name": "mt/sorted-linked-list",
    "description": "A library providing sortedLinkedList for string and int input",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Mt\\SortedLinkedList\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit tests",
        "cs": "php-cs-fixer fix --diff",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse -c phpstan.neon",
        "check": [
            "@cs:check",
            "@phpstan",
            "@test"
        ]
    },
    "authors": [
        {
            "name": "Matouš Kadrnoška"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "phpunit/phpunit": "^13.2@dev",
        "phpstan/phpstan": "2.2.x-dev",
        "friendsofphp/php-cs-fixer": "dev-master"
    }
}
